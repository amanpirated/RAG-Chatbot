   "source": [
    "#----------------Chat loop-----------------------\n",
    "while True:\n",
    "    query = input(\"You: \")\n",
    "\n",
    "    if query.lower() == \"exit\":\n",
    "        break\n",
    "\n",
    "    query_embedding = model.encode([query])\n",
    "\n",
    "    distances, indices = index.search(\n",
    "        np.array(query_embedding),\n",
    "        k=3\n",
    "    )\n",
    "\n",
    "    context = \"\\n\".join(\n",
    "        chunks[i]\n",
    "        for i in indices[0]\n",
    "    )\n",
    "\n",
    "    prompt = f\"\"\"\n",
    "    Context:\n",
    "    {context}\n",
    "\n",
    "    Question:\n",
    "    {query}\n",
    "    \"\"\"\n",
    "\n",
    "    try:\n",
    "        response = client.models.generate_content(\n",
    "            model=\"gemini-2.5-flash\",\n",
    "            contents=prompt\n",
    "        )\n",
    "    except Exception as e:\n",
    "        print(f\"Error: {e}\")\n",
    "        print(\"API is currently unavailable. Please try again later.\")\n",
    "        continue\n",
    "\n",
    "    print(\"Bot:\", response.text)"
   ]
