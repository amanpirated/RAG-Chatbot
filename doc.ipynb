   "source": [
    "#-----------------Generating Response------------------\n",
    "response=client.models.generate_content(\n",
    "    model=\"gemini-2.5-flash-lite\",\n",
    "    contents=prompt\n",
    ")\n",
    "print(response.text)"
   ]
  },
