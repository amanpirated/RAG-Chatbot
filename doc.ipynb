    "# -------------- LOADING PDF -----------------\n",
    "from pypdf import PdfReader\n",
    "reader=PdfReader(\"C:\\\\Users\\\\Admin\\\\OneDrive\\\\Desktop\\\\chatbot\\\\data\\\\notes.pdf\")\n",
    "text=\"\"\n",
    "\n",
    "for page in reader.pages:\n",
    "    text+=page.extract_text()\n",
    "print(\" ✅ PDF loaded successfully\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "b99e47a2",
   "metadata": {},
   "outputs": [],
   "source": [
    "#-----------------CHUNKING---------------------\n",
    "def chunkText(text,chunk_size=500):\n",
    "    chunks=[]\n",
    "    for i in range(0,len(text),chunk_size):\n",
    "        chunks.append(text[i:i+chunk_size])\n",
    "\n",
    "    return chunks\n",
    "chunks=chunkText(text)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "98e3889c",
   "metadata": {},
   "outputs": [
