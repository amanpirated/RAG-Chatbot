   "source": [
    "#-----------------Embedding--------------------\n",
    "from sentence_transformers import SentenceTransformer\n",
    "\n",
    "model=SentenceTransformer(\"all-MiniLM-l6-v2\")\n",
    "embeddings=model.encode(chunks)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "b28863b8",
   "metadata": {},
   "outputs": [],
   "source": [
    "#--------------Storing Embeddings----------------\n",
    "import faiss\n",
    "import numpy as np\n",
    "\n",
    "dimension = embeddings.shape[1]\n",
    "index = faiss.IndexFlatL2(dimension)\n",
    "index.add(np.array(embeddings))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "23dc8aa3",
   "metadata": {},
   "outputs": [],
   "source": [
    "#-----------Retrieving Relevant Chunks-------------\n",
    "query = \"What is supervised learning?\"\n",
    "query_embedding = model.encode([query])\n",
    "\n",
    "distances, indices = index.search(\n",
    "    np.array(query_embedding),\n",
    "    k=3\n",
    ")\n",
    "retrieved_chunks = [\n",
    "    chunks[i]\n",
    "    for i in indices[0]\n",
    "]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "3ed0139c",
   "metadata": {},
   "outputs": [],
   "source": [
    "#-----------------Sending Comtext to Gemini----------------\n",
    "from google import genai\n",
    "client=genai.Client(api_key=\"YOUR API KEY")\n",
    "\n",
    "context='/n'.join(retrieved_chunks)\n",
    "prompt=f\"\"\" \n",
    "Answer only from the context. \n",
    "Context: {context} \n",
    "Question: {query}\n",
    "\"\"\""
   ]
  },
  {
   "cell_type": "code",
